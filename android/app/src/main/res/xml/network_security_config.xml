<?xml version="1.0" encoding="utf-8"?>
<!-- บังคับ HTTPS ทุกการเชื่อมต่อ และเชื่อเฉพาะใบรับรองของระบบ (ไม่เชื่อใบรับรองที่ผู้ใช้ติดตั้งเอง) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
