<?xml version="1.0" encoding="utf-8"?>
<!-- ไม่สำรองข้อมูลขึ้นคลาวด์ และไม่ย้ายข้อมูลไปเครื่องใหม่ (ข้อมูลบทสนทนาอยู่แค่ในเครื่องนี้) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
